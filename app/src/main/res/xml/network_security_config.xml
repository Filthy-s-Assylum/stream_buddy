<?xml version="1.0" encoding="utf-8"?>
<!--
  HLS/DASH endpoints are frequently served over plain HTTP (local media servers,
  self-hosted libraries, carrier CDNs). Playback of http:// URLs therefore has to be
  permitted for the player to work. Traffic is only fetched for URLs the user adds.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>